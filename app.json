{
  "expo": {
    "name": "ToW-Scoring-Calculator",
    "slug": "ToW-Scoring-Calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/OldWorld Scoring.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.orihillairetdev.towscoringcalculator",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2196F3",
        "foregroundImage": "./assets/OldWorld Scoring_foreground.png",
        "backgroundImage": "./assets/OldWorld Scoring_background.png",
        "monochromeImage": "./assets/OldWorld Scoring_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/OldWorld Scoring.png"
    },
    "extra": {
      "eas": {
        "projectId": "3db2ce0a-42a4-405b-85ca-40c345ca4ab5"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ITC Serif Gothic Std Heavy.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "ITCSerifGothicHeavy",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/ITC Serif Gothic Std Heavy.otf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/ITC Serif Gothic Std Heavy.otf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2196F3",
          "image": "./assets/OldWorld Scoring.png",
          "imageWidth": 192
        }
      ]
    ]
  }
}
